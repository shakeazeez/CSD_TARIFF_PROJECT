# CSD Tariff Project - Environment Variables

# Copy this file to .env and fill in your actual values
# Never commit your .env file to version control!

# DATABASE CONFIGURATION
# PostgreSQL database credentials
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password


# FRONTEND CONFIGURATION
# Backend API URL for the React frontend
VITE_BACKEND_URL=http://localhost:8080
# Frontend application URL
FRONTEND_URL=http://localhost


# DATABASE CONNECTION STRINGS

# JDBC URL for Java Spring Boot services (format: jdbc:postgresql://host:port/database)
DATABASE_URL=jdbc:postgresql://localhost:5432/tariff_dev
# PostgreSQL connection URL for Rust services (format: postgresql://user:password@host:port/database)
RUST_DATABASE_URL=postgresql://username:password@localhost:5432/tariff_dev


# SECURITY & API KEYS
# JWT signing secret for authentication tokens (use a strong, random string)
SIGNING_SECRET=your_jwt_signing_secret_here
# Moach API key for additional services
MOACH_API_KEY=your_moach_api_key
# OpenAI API key for AI-powered news analysis and features
OPEN_AI_KEY=your_openai_api_key
# NewsAPI key for fetching real-time trade news
THE_NEWS_API_KEY=your_newsapi_key


# MICROSERVICE URLS
# Tariff calculation service URL (Java Spring Boot)
TARIFF_URL=http://localhost:8081
# User management service URL (Java Spring Boot)
USER_URL=http://localhost:8082
# News aggregation service URL (Java Spring Boot)
NEWS_URL=http://localhost:8083


# LOGGING & HOST CONFIGURATION
# Rust logging level (debug, info, warn, error)
RUST_LOG=info
# Host and port for the Rust API gateway
HOST=localhost:8080